# Planet Weather Terminal Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Weather API (Optional - default uses Open-Meteo free API without key)
# OPENWEATHER_API_KEY=your_openweather_api_key_here

# NASA JPL Horizons API Base URL
NASA_HORIZONS_API_URL=https://ssd.jpl.nasa.gov/api/horizons.api

# Cache Time-To-Live (in seconds)
CACHE_TTL_EPHEMERIS=3600
CACHE_TTL_WEATHER=600
